# Variables para el docker-compose de la raíz de PRODUCTO.
# Copia este archivo a ".env" (en la misma carpeta) y ajusta los valores.
# docker compose lo lee automáticamente.

# Contraseña de PostgreSQL.
DB_PASSWORD=password

# Secreto JWT (mínimo 32 caracteres). Genera uno seguro con:
#   openssl rand -base64 64
JWT_SECRET=dev-only-cambia-en-produccion-openssl-rand-base64-64

# Origen permitido para CORS (origen del frontend dockerizado).
APP_CORS_ORIGINS=http://localhost:8080

# Configuración SMTP para el envío de correos (opcional; dejar vacío para desactivar).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
